# Runtime Environment
PORT=3000
NODE_ENV=development

# Gateway Installation Identity & Signing Keypair
GATEWAY_ID="gw_aamarva_local_01"
MCP_SERVER_ID="mcp_srv_default_01"
GATEWAY_PUBLIC_URL="https://gateway.example.com"
GATEWAY_ACTIVE_SIGNING_KEY_ID="gw-signing-2026-01"
GATEWAY_SIGNING_KEYS_JSON='{"gw-signing-2026-01":{"privateKeyPem":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"}}'

# AAMARVA Core Backend Integration
AAMARVA_BASE_URL="https://api.aamarva.example.com"
# Shared secret or service credential for authenticating Gateway <-> AAMARVA backend requests
AAMARVA_BACKEND_AUTH_SECRET="replace-with-strong-32-byte-secret"
# JSON map of keyId -> PEM public key for verifying AAMARVA-signed authorization payloads (supports rotation)
AAMARVA_TRUSTED_SIGNING_KEYS_JSON='{"aamarva-key-2026-01":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
# Maximum clock skew in seconds for signed payloads and backend relay requests
AAMARVA_MAX_CLOCK_SKEW_SECONDS=60
# Mandatory in production (fail-closed) unless ALLOW_OFFLINE_REVOCATION_IN_PROD=true
AAMARVA_ONLINE_REVOCATION_CHECK=true
ALLOW_OFFLINE_REVOCATION_IN_PROD=false

# Token & Session Security
TOKEN_TTL_SECONDS=120
SESSION_TTL_SECONDS=900
REQUIRE_TLS=true
# Comma-separated reverse proxy peer IPs trusted to terminate TLS and supply X-Forwarded-Proto
TRUSTED_PROXY_IPS=""
ALLOW_IN_MEMORY_STORE=false
# Dev/test-only explicit opt-in for local loopback MCP endpoints (prohibited in production)
ALLOW_LOOPBACK_MCP_IN_DEV=false

# Rate Limiting & Request Bounds
MAX_REQUEST_BODY_BYTES=1048576
REDEEM_RATE_LIMIT_MAX=30
REDEEM_RATE_LIMIT_WINDOW_MS=60000
RELAY_RATE_LIMIT_MAX=300
RELAY_RATE_LIMIT_WINDOW_MS=60000

# State Storage (sqlite | redis | memory [non-prod only])
STATE_STORE_DRIVER="sqlite"
SQLITE_DB_PATH="./data/gateway-state.db"
# REDIS_URL="rediss://:password@redis.example.com:6379"

# Upstream MCP Server Configuration (stdio | streamable-http)
MCP_TRANSPORT="stdio"
MCP_STDIO_COMMAND="node"
MCP_STDIO_ARGS_JSON='["examples/sample-mcp-stdio.ts"]'
# MCP_HTTP_URL="http://127.0.0.1:4100/mcp"
# MCP_UPSTREAM_AUTH_HEADER="Bearer owner-local-mcp-secret"
MCP_REQUEST_TIMEOUT_MS=15000

# Operator Console & Local Sandbox (disabled by default in production)
ENABLE_OPERATOR_CONSOLE=false
# Mandatory (>=32 chars) if ENABLE_OPERATOR_CONSOLE=true in production
OPERATOR_CONSOLE_AUTH_TOKEN=""
ENABLE_SANDBOX=false

# Platform Variables (do not place secrets here)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
